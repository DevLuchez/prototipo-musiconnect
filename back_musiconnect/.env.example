# Copie este arquivo para .env e preencha com seus valores reais
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/musiconnect

# LLM — Google Gemini para enriquecimento de oportunidades
GEMINI_API_KEY=

# E-mail de confirmação de cadastro (Resend — https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Chave das rotas de administração (header X-Admin-Key). Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vazia = rotas de administração sempre bloqueadas.
ADMIN_API_KEY=
