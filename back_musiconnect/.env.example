# Copie este arquivo para .env e preencha com seus valores reais.
# Usado ao rodar a API fora do Docker (uvicorn no venv). O banco é o PostGIS
# do docker compose, exposto na porta 5433 do computador.
DATABASE_URL=postgresql+psycopg://postgres:sua_senha@localhost:5433/musiconnect

# Banco SEPARADO para os testes (criado automaticamente pelo pytest) — nunca
# aponte para o banco de desenvolvimento.
TEST_DATABASE_URL=postgresql+psycopg://postgres:sua_senha@localhost:5433/musiconnect_test

# ETL (00h), coleta (06h) e notificações (09h) só rodam no servidor — no
# computador, gastariam a cota do Gemini em dobro.
SCHEDULER_ENABLED=false

# LLM — Google Gemini para interpretar os editais
GEMINI_API_KEY=

# E-mails de confirmação de cadastro e de redefinição de senha (Resend — https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=nao-responda@musiconnect.app.br

# Chave das rotas de administração (header X-Admin-Key). Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vazia = rotas de administração sempre bloqueadas.
ADMIN_API_KEY=
