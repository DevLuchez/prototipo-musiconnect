# Copie este arquivo para .env (na raiz) e preencha com seus valores reais.
# Usado pelo docker compose — no computador (banco e API em contêiner) e no
# servidor (com docker-compose.prod.yml).
POSTGRES_PASSWORD=sua_senha_aqui

# LLM — Google Gemini para interpretar os editais
GEMINI_API_KEY=

# E-mails de confirmação de cadastro e de redefinição de senha (Resend — https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=nao-responda@musiconnect.app.br

# Chave das rotas de administração (header X-Admin-Key). Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vazia = rotas de administração sempre bloqueadas.
ADMIN_API_KEY=
