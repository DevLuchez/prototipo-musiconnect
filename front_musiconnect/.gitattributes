# Arquivos gerados pelo Flutter a cada build: ele os escreve sempre com
# fim de linha LF. Sem esta regra, o Git (core.autocrlf no Windows) os
# mostra como modificados mesmo sem mudança nenhuma.
linux/flutter/generated_* text eol=lf
windows/flutter/generated_* text eol=lf
macos/Flutter/GeneratedPluginRegistrant.swift text eol=lf
