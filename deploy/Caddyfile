# Caddy — porta de entrada do servidor, com HTTPS automático.
#
#   api.musiconnect.app.br → API (o app fala com ela)
#   musiconnect.app.br     → página de download do app + links dos e-mails
#                            (confirmar cadastro, redefinir senha), que são
#                            páginas da API

api.musiconnect.app.br {
	encode gzip
	reverse_proxy api:8000
}

musiconnect.app.br {
	encode gzip

	@api path /confirmar /redefinir-senha /.well-known/assetlinks.json
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		# O navegador sempre confere com o servidor (ETag) antes de reusar a
		# cópia guardada — uma logo ou página trocada aparece no próximo acesso.
		header Cache-Control "no-cache"
		root * /srv/site
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}

www.musiconnect.app.br {
	redir https://musiconnect.app.br{uri} permanent
}
